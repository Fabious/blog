---
layout: base.njk
permalink: /
---
<div class="home">
  <aside>
    <h1>{{ site.title }}</h1>
    <p>{{ site.tagline }}</p>
  </aside>
  <ol class="posts">
    {%- for post in collections.post %}
    <li>
      <time datetime="{{ post.date.toISOString() }}">{{ post.date | formatDate }}</time>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="meta">{{ post.templateContent | readingTime }} min · {{ post.data.lang | langMark }}</span>
    </li>
    {%- endfor %}
  </ol>
</div>
